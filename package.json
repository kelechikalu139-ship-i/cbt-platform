{
  "name": "cbt-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Computer Based Testing Platform - Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=apps/web",
    "build:admin": "npm run build --workspace=apps/admin",
    "build:server": "npm run build --workspace=server",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:studio": "npm run db:studio --workspace=server",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "backup:db": "node scripts/backup-db.js",
    "health:check": "node scripts/health-check.js"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.19.1",
    "@types/node": "^22.5.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "bcrypt": true,
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "@prisma/get-platform": true
  }
}
