# CBT Admin — development environment
# Copy to .env and adjust. Never commit real credentials.

# --- API connection ---------------------------------------------------------
# Leave VITE_API_URL unset to use the default below.

# Default: the relative path `/api/v1`, which the Vite dev server proxies to the
# backend. This is the recommended setting: the browser only ever talks to the
# dev server, and once the built app is served behind the same reverse proxy as
# the API in production, no rebuild is needed if the server's IP changes.
#
# Set an absolute URL only when the API lives on a different host, for example
# during LAN testing from a second machine:
#   VITE_API_URL=http://192.168.1.217:5000/api/v1
VITE_API_URL=

# Target for the dev-server proxy above. Point this at whichever machine runs the
# backend; it must match the API's PORT (default 5000). Not exposed to the client.
VITE_SERVER_ORIGIN=http://localhost:5000

# When true, the admin UI reads from the in-memory mock layer in src/mocks
# instead of calling the API. Set false to talk to the real backend.
VITE_USE_MOCK=true

# Display name shown in the header / document title.
VITE_APP_NAME=CBT Administration

# The installation identity, displayed on the System Health page.
# Generated by the installer; safe to leave blank during UI development.
VITE_INSTALLATION_ID=
