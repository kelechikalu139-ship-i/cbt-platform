# Web App
# Relative by default: the Vite dev server proxies /api to the
# Node.js API, and production serves the app from the API host.
# Set an absolute URL only when the API lives on another origin.
VITE_APP_NAME=CBT Platform
VITE_API_URL=/api/v1

# When true, the app runs on the in-memory mock data layer and never
# calls the API. Set to false once the server is running.
VITE_USE_MOCK=true

NODE_ENV=development
