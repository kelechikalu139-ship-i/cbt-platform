# ---------------------------------------------------------------------------
# CBT Examination System — backend environment template
#
# Copy to `.env` and edit. `.env` is git-ignored and must never be committed.
#
# The server validates every variable below with Zod at startup and refuses to
# boot if anything is missing or malformed (see src/config/env.ts).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Bind address. 0.0.0.0 is required for LAN access so student PCs can reach the
# server. Use 127.0.0.1 to restrict to the server PC itself.
HOST=0.0.0.0

APP_NAME="CBT Examination System"
APP_VERSION=1.0.0

# --- Database --------------------------------------------------------------
# Prisma + MariaDB. Never hardcode credentials in source.
DATABASE_URL="mysql://cbt:cbtpass@127.0.0.1:3306/cbt_system"

# Fail fast rather than hang when the database is unreachable.
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# --- Authentication --------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# These MUST be replaced. The server refuses to start in production if either
# still holds the placeholder value below.
JWT_ACCESS_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
JWT_REFRESH_SECRET="CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING"

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt work factor. 12 is a sane 2024+ default; lower only on slow lab hardware.
BCRYPT_SALT_ROUNDS=12

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins. The admin app on the same machine and
# the LAN address of the server PC both need to be listed during development.
# Use "*" only if you accept the risk of any LAN origin calling the API.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://192.168.1.100:5174"

# --- Logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Pretty logs for humans; set to false in production for JSON lines.
LOG_PRETTY=true

# --- Rate limiting ---------------------------------------------------------
# Auth endpoints are strictly limited to resist credential stuffing.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# The global limiter is deliberately generous: during an examination a whole
# lab can legitimately fire requests at the same moment, and throttling a
# student's answer save is worse than tolerating the traffic.
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=3000

# --- Seed (development only) ----------------------------------------------
# Credentials for the seeded development administrator. Refused when
# NODE_ENV=production.
SEED_ADMIN_EMAIL="admin@cbt.local"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_FIRST_NAME="System"
SEED_ADMIN_LAST_NAME="Administrator"

# Password for the seeded student portal accounts (the two
# candidates the practice paper is set for). Skipped when unset.
SEED_STUDENT_PASSWORD="Student@12345"