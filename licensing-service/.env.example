NODE_ENV=production
PORT=8080
HOST=0.0.0.0
# Local PostgreSQL development (merge these values into .env and set NODE_ENV=development):
# DATABASE_URL=postgresql://postgres:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/cbt_licensing_platform
# PGSSL=false
# Neon/hosted PostgreSQL: use the pooled URL from Neon for the API runtime.
# The local Neon CLI stores it in the gitignored repository-root .env.local.
# Copy it into Render's DATABASE_URL secret; do not commit the real URL.
# Example shape only (not a usable credential):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:REPLACE_WITH_STRONG_PASSWORD@HOST:5432/neondb?sslmode=require
EXPECTED_DATABASE_NAME=cbt_licensing_platform
DB_POOL_SIZE=5
PGSSL=true
# One-time setup only: used by `npm run admin:bootstrap` to bind the setup link.
# This value is not an administrator password and is not needed at runtime.
LICENSE_ADMIN_EMAIL=licensing-admin@example.com
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
# Generate a separate 32-byte key for encrypting admin TOTP secrets at rest.
MFA_ENCRYPTION_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_KEY
# Base64 encoded PEM Ed25519 PKCS8 private key and SPKI public key. Keep the private value server-side.
LICENSE_PRIVATE_KEY_B64=REPLACE_WITH_PRIVATE_KEY_B64
LICENSE_PUBLIC_KEY_B64=REPLACE_WITH_PUBLIC_KEY_B64
PORTAL_ORIGIN=https://licenses.example.com
