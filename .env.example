# Application
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cbt_platform?schema=public"

# JWT
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URLs
WEB_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Redis (optional, for session caching)
REDIS_URL=redis://localhost:6379

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@cbtplatform.com

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_SALT_ROUNDS=12

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Seed admin (used by scripts/seed-admin.ts)
SEED_ADMIN_EMAIL=admin@cbtplatform.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=System Admin